# Host development only. Load with node --env-file=.env or your environment manager.
NODE_ENV=development
DATABASE_URL='postgresql://stagelink:local-development-only@127.0.0.1:55432/stagelink_dev?connect_timeout=3'
REDIS_URL=redis://127.0.0.1:56379
PORT=4000
WORKER_HEALTH_PORT=4001
WEB_ORIGIN=http://localhost:3000

# Generate two different 32-byte keys with scripts/setup-env.mjs. Never commit actual keys.
AUTH_JWT_SECRET=
AUTH_MAIL_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=noreply@stagelink.local

# Separate AES-256-GCM key for payout details; generated by setup-env.
PAYOUT_DATA_KEY=

# Local development uses a loopback-only S3 emulator; production uses MEDIA_DRIVER=aws and the AWS credential chain.
MEDIA_DRIVER=local-s3
S3_REGION=us-east-1
S3_BUCKET=stagelink-media
S3_ENDPOINT=http://127.0.0.1:59090

# Optional PayHere sandbox. Set all three together. The webhook requires public HTTPS.
PAYHERE_SANDBOX_MERCHANT_ID=
PAYHERE_SANDBOX_MERCHANT_SECRET=
PAYHERE_SANDBOX_RETRIEVAL_APP_ID=
PAYHERE_SANDBOX_RETRIEVAL_APP_SECRET=
PAYHERE_SANDBOX_NOTIFY_URL=

# Optional Stripe test mode. Set both together.
STRIPE_TEST_REFUND_EXECUTION=false
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=

# Optional internal FastAPI origin for status. Compose supplies this setting.
AI_SERVICE_ORIGIN=
AI_INTERNAL_TOKEN=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DAILY_LIMIT=20
AI_SEMANTIC_RECOMMENDATIONS=false
AI_SEMANTIC_DAILY_LIMIT=20
AI_PREVIEW_DAILY_LIMIT=20
AI_GENERATION_DAILY_LIMIT=20

PROMOTIONAL_EMAIL_DELIVERY=false
PROMOTIONAL_EMAIL_HOURLY_LIMIT=100
BOOKING_EMAIL_REMINDERS=false

# Public HTTPS API origin for promotional one-click unsubscribe.
PROMOTIONAL_UNSUBSCRIBE_ORIGIN=
