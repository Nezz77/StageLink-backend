  version Int
  body String @db.VarChar(3000)
  reason String @db.VarChar(500)
  actorId String? @map("actor_id") @db.Uuid
  rolledBackFrom Int? @map("rolled_back_from")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  template AiPromptTemplate @relation(fields: [key], references: [key], onDelete: Restrict)
  actor AuthUser? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  rollbackSource AiPromptVersion? @relation("PromptRollback", fields: [key, rolledBackFrom], references: [key, version], onDelete: Restrict)
  rollbacks AiPromptVersion[] @relation("PromptRollback")
  @@id([key, version])
  @@map("ai_prompt_versions")
}

model RecommendationRun {
  id String @id @default(uuid()) @db.Uuid
  briefId String @map("brief_id") @db.Uuid
  requestKey String @map("request_key") @db.Uuid
  briefRevision Int @map("brief_revision")
  weightsRevision Int @map("weights_revision")
  genres Json
  method String @db.VarChar(24)
  results Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  brief EventBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  weights MatchingVersion @relation(fields: [weightsRevision], references: [revision], onDelete: Restrict)
  @@unique([briefId, requestKey])
  @@map("recommendation_runs")
}

enum VerificationStatus {
  pending
  approved
  rejected
}

model VerificationCase {
  id String @id @default(uuid()) @db.Uuid
  providerId String @map("provider_id") @db.Uuid
  kind AuthRole
  requestKey String @map("request_key") @db.Uuid
  version Int
  subject String @db.VarChar(140)
  body String @db.VarChar(2000)
  status VerificationStatus @default(pending)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedBy String? @map("decided_by") @db.Uuid
  decidedAt DateTime? @map("decided_at") @db.Timestamptz(3)
  reason String? @db.VarChar(2000)
  provider AuthUser @relation("VerificationProvider", fields: [providerId], references: [id], onDelete: Restrict)
  reviewer AuthUser? @relation("VerificationReviewer", fields: [decidedBy], references: [id], onDelete: Restrict)
  documents VerificationDocument[]
  @@unique([providerId, kind, version])
  @@unique([providerId, requestKey])
  @@index([status, id])
  @@map("verification_cases")
}

model VerificationDocument {
  caseId String @map("case_id") @db.Uuid
  assetId String @map("asset_id") @db.Uuid
  position Int
  case VerificationCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  @@id([caseId, assetId])
  @@unique([caseId, position])
  @@index([assetId])
  @@map("verification_documents")
}

enum SupportStatus {
  open
  resolved
}

enum SupportEntryKind {
  reply
  note
  status
  assignment
}

model SupportCase {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  bookingId String? @map("booking_id") @db.Uuid
  assigneeId String? @map("assignee_id") @db.Uuid
  requestKey String @map("request_key") @db.Uuid
  subject String @db.VarChar(140)
  body String @db.VarChar(2000)
  status SupportStatus @default(open)
  revision Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  owner AuthUser @relation("SupportOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  assignee AuthUser? @relation("SupportAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  entries SupportEntry[]
  attachments SupportAttachment[]
  @@unique([ownerId, requestKey])
  @@index([ownerId, id])
  @@index([status, id])
  @@map("support_cases")
}

model SupportEntry {
  id BigInt @id @default(autoincrement())
  caseId String @map("case_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  requestKey String? @map("request_key") @db.Uuid
  kind SupportEntryKind
  staff Boolean
  body String @db.VarChar(2000)
  revision Int?
  assigneeId String? @map("assignee_id") @db.Uuid
  status SupportStatus?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  case SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor AuthUser @relation("SupportActor", fields: [actorId], references: [id], onDelete: Restrict)
  assignee AuthUser? @relation("SupportEntryAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  @@unique([caseId, actorId, requestKey])
  @@unique([caseId, revision])
  @@index([caseId, id])
  @@map("support_entries")
}

model SupportAttachment {
  caseId String @map("case_id") @db.Uuid
  assetId String @map("asset_id") @db.Uuid
  position Int
  case SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  @@id([caseId, assetId])
  @@unique([caseId, position])
  @@index([assetId])
  @@map("support_attachments")
}

enum ArbitrationMode {
  refund
  provider
  split
}

model BookingDispute {
  id String @id @default(uuid()) @db.Uuid
  bookingId String @unique @map("booking_id") @db.Uuid
  openedBy String @map("opened_by") @db.Uuid
  subject String @db.VarChar(140)
  body String @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  dismissedAt DateTime? @map("dismissed_at") @db.Timestamptz(3)
  dismissedBy String? @map("dismissed_by") @db.Uuid
  dismissalReason String? @map("dismissal_reason") @db.VarChar(2000)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  opener AuthUser @relation("DisputeOpener", fields: [openedBy], references: [id], onDelete: Restrict)
  dismisser AuthUser? @relation("DisputeDismisser", fields: [dismissedBy], references: [id], onDelete: Restrict)
  attachments BookingDisputeAttachment[]
  decision ArbitrationDecision?
  @@map("booking_disputes")
}

model BookingDisputeAttachment {
  disputeId String @map("dispute_id") @db.Uuid
  assetId String @map("asset_id") @db.Uuid
  position Int
  dispute BookingDispute @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  @@id([disputeId, assetId])
  @@unique([disputeId, position])
  @@index([assetId])
  @@map("booking_dispute_attachments")
}

model ArbitrationDecision {
  id String @id @default(uuid()) @db.Uuid
  disputeId String @unique @map("dispute_id") @db.Uuid
  decidedBy String @map("decided_by") @db.Uuid
  providerId String @map("provider_id") @db.Uuid
  destinationRevision Int? @map("destination_revision")
  mode ArbitrationMode
  heldMinor Int @map("held_minor")
  refundMinor Int @map("refund_minor")
  feeMinor Int @map("fee_minor")
  payoutMinor Int @map("payout_minor")
  reason String @db.VarChar(2000)
  reservationId String @unique @map("reservation_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  dispute BookingDispute @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  reviewer AuthUser @relation("ArbitrationReviewer", fields: [decidedBy], references: [id], onDelete: Restrict)
  provider AuthUser @relation("ArbitrationProvider", fields: [providerId], references: [id], onDelete: Restrict)
  destination PayoutDestinationVersion? @relation(fields: [providerId, destinationRevision], references: [userId, revision], onDelete: Restrict, map: "arbitration_decisions_destination_fkey")
  reservation JournalTransaction @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  sources ArbitrationSource[]
  @@map("arbitration_decisions")
}

model ArbitrationSource {
  decisionId String @map("decision_id") @db.Uuid
  orderId String @unique @map("order_id") @db.Uuid
  capturedMinor Int @map("captured_minor")
  refundMinor Int @map("refund_minor")
  decision ArbitrationDecision @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  order PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@id([decisionId, orderId])
  @@map("arbitration_sources")
}

enum ReminderStatus {
  queued
  sending
  accepted
  failed
  unknown
  cancelled
}

model BookingReminder {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String @map("booking_id") @db.Uuid
  recipientId String @map("recipient_id") @db.Uuid
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  dueAt DateTime @map("due_at") @db.Timestamptz(3)
  offsetHours Int @map("offset_hours")
  status ReminderStatus @default(queued)
  attempts Int @default(0)
  sendingAt DateTime? @map("sending_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  lastCode String? @map("last_code") @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  recipient AuthUser @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  adminActions ReminderAdminAction[]
  @@unique([bookingId, recipientId, startsAt, offsetHours])
  @@index([status, dueAt])
  @@map("booking_reminders")
}

model ReminderAdminAction {
  id String @id @default(uuid()) @db.Uuid
  reminderId String @map("reminder_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  action String @db.VarChar(12)
  reason String @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  reminder BookingReminder @relation(fields: [reminderId], references: [id], onDelete: Restrict)
  actor AuthUser @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([reminderId])
  @@map("reminder_admin_actions")
}

enum NotificationKind {
  provider_decision
  agreement
  payment
  completion
  arbitration
  support
}

model Notification {
  id BigInt @id @default(autoincrement())
  recipientId String @map("recipient_id") @db.Uuid
  kind NotificationKind
  sourceId String @map("source_id") @db.Uuid
  eventKey String @map("event_key") @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt DateTime? @map("read_at") @db.Timestamptz(3)
  recipient AuthUser @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  @@unique([recipientId, kind, eventKey])
  @@index([recipientId, id])
  @@map("notifications")
}

model NotificationPreference {
  userId String @id @map("user_id") @db.Uuid
  bookingReminderEmail Boolean @default(true) @map("booking_reminder_email")
  revision Int @default(1)
  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("notification_preferences")
}

model SystemSetting {
  id Int @id
  maintenance Boolean @default(false)
  maintenanceMessage String? @map("maintenance_message") @db.VarChar(500)
  revision Int @default(1)
  announcementCacheVersion BigInt @default(0) @map("announcement_cache_version")
  @@map("system_settings")
}

enum SystemAuditAction {
  maintenance
  announcement_publish
  announcement_unpublish
  announcement_cache_invalidate
  sessions_revoke
}

model SystemAuditEntry {
  id BigInt @id @default(autoincrement())
  actorId String @map("actor_id") @db.Uuid
  action SystemAuditAction
  targetId String? @map("target_id") @db.Uuid
  reason String @db.VarChar(500)
  details Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor AuthUser @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@map("system_audit_entries")
}
