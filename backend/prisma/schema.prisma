generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  topic          String
  payload        Json
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)
  enqueuedAt     DateTime? @map("enqueued_at") @db.Timestamptz(3)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(3)
  deadLetteredAt DateTime? @map("dead_lettered_at") @db.Timestamptz(3)
  attempts       Int       @default(0)
  lastErrorCode  String?   @map("last_error_code")
  consumedEvents ConsumedEvent[]
  receipt FoundationReceipt?
  @@map("outbox_events")
}

model ConsumedEvent {
  consumer    String
  eventId     String    @map("event_id") @db.Uuid
  processedAt DateTime  @default(now()) @map("processed_at") @db.Timestamptz(3)
  event OutboxEvent @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([consumer, eventId])
  @@map("consumed_events")
}

// Harmless internal effect; not a business record or production fixture.
model FoundationReceipt {
  eventId    String   @id @map("event_id") @db.Uuid
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  event OutboxEvent @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@map("foundation_receipts")
}

enum AuthRole {
  customer
  artist
  renter
  admin
}
model AuthUser {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(200)
  displayName String @map("display_name") @db.VarChar(80)
  passwordHash String @map("password_hash")
  roles AuthRole[] @default([customer])
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  disabledAt DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  sessions AuthSession[]
  tokens AuthToken[]
  mail AuthMail[]
  profile MemberProfile?
  providers ProviderProfile[]
  payout PayoutDestination?
  payoutVersions PayoutDestinationVersion[]
  pendingEmail PendingEmailChange?
  assets Asset[]
  portfolio PortfolioItem[]
  avatar AvatarBinding?
  artistGigs ArtistGig[]
  rentals RentalListing[]
  eventBriefs EventBrief[]
  savedItems SavedItem[]
  privateDrafts PrivateDraft[]
  customerInquiries Inquiry[] @relation("InquiryCustomer")
  providerInquiries Inquiry[] @relation("InquiryProvider")
  inquiryMessages InquiryMessage[]
  bookingMessages BookingMessage[]
  bookingMessageReads BookingMessageRead[]
  availability AvailabilityCalendar?
  authoredQuotations BookingQuotation[] @relation("QuotationAuthor")
  decidedQuotations BookingQuotation[] @relation("QuotationDecider")
  createdPayouts PayoutOrder[]
  payoutHoldEvents BookingPayoutHold[]
  reviewModerations BookingReviewModeration[]
  submittedInspections EquipmentInspectionReport[] @relation("InspectionSubmitter")
  decidedInspections EquipmentInspectionReport[] @relation("InspectionDecider")
  systemAuditEntries SystemAuditEntry[]
  bookingReminders BookingReminder[]
  notifications Notification[]
  notificationPreferences NotificationPreference?
  reminderActions ReminderAdminAction[]
  openedDisputes BookingDispute[] @relation("DisputeOpener")
  dismissedDisputes BookingDispute[] @relation("DisputeDismisser")
  arbitrationDecisions ArbitrationDecision[] @relation("ArbitrationReviewer")
  arbitrationAllocations ArbitrationDecision[] @relation("ArbitrationProvider")
  ownedSupportCases SupportCase[] @relation("SupportOwner")
  assignedSupportCases SupportCase[] @relation("SupportAssignee")
  supportEntries SupportEntry[] @relation("SupportActor")
  supportAssignments SupportEntry[] @relation("SupportEntryAssignee")
  matchingVersions MatchingVersion[]
  promptVersions AiPromptVersion[]
  verificationCases VerificationCase[] @relation("VerificationProvider")
  reviewedVerificationCases VerificationCase[] @relation("VerificationReviewer")
  resolvedDamageClaims DamageClaim[]
  decidedRefunds RefundRequest[]
  checkIns BookingCheckIn[]
  proposedOvertime OvertimeProposal[] @relation("OvertimeAuthor")
  decidedOvertime OvertimeProposal[] @relation("OvertimeDecider")
  reportedCompletions BookingCompletion[] @relation("CompletionReporter")
  verifiedCompletions BookingCompletion[] @relation("CompletionVerifier")
  customerBookings Booking[] @relation("BookingCustomer")
  providerBookings Booking[] @relation("BookingProvider")
  @@map("auth_users")
}
model AuthSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  activeRole AuthRole @map("active_role")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  user AuthUser @relation(fields:[userId], references:[id], onDelete:Cascade, onUpdate:Cascade)
  credentials AuthRefresh[]
  @@index([userId, revokedAt])
  @@map("auth_sessions")
}
model AuthRefresh {
  id String @id @default(uuid()) @db.Uuid
  sessionId String @map("session_id") @db.Uuid
  secretDigest String @map("secret_digest") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  session AuthSession @relation(fields:[sessionId], references:[id], onDelete:Cascade, onUpdate:Cascade)
  @@index([sessionId])
  @@map("auth_refresh_credentials")
}
model AuthToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  purpose String
  email String @db.VarChar(200)
  digest String @unique @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  usedAt DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user AuthUser @relation(fields:[userId], references:[id], onDelete:Cascade, onUpdate:Cascade)
  @@index([userId,purpose,usedAt])
  @@map("auth_tokens")
}
model AuthMail {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  sealedPayload String? @map("sealed_payload")
  status String @default("pending")
  attempts Int @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)
  leaseOwner String? @map("lease_owner") @db.Uuid
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)
  lastErrorCode String? @map("last_error_code")
  user AuthUser @relation(fields:[userId], references:[id], onDelete:Cascade, onUpdate:Cascade)
  @@map("auth_mail_outbox")
}

model MemberProfile {
  userId String @id @map("user_id") @db.Uuid
  revision Int @default(1)
  city String @db.VarChar(100)
  phone String @db.VarChar(32)
  organization String @db.VarChar(120)
  bio String @db.VarChar(2000)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  user AuthUser @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@map("member_profiles")
}

model ProviderProfile {
  userId String @map("user_id") @db.Uuid
  kind AuthRole
  revision Int @default(1)
  displayName String @map("display_name") @db.VarChar(120)
  bio String @db.VarChar(2000)
  city String @db.VarChar(100)
  serviceRadiusKm Int @map("service_radius_km")
  latitude Decimal? @db.Decimal(9,6)
  longitude Decimal? @db.Decimal(9,6)
  address String @db.VarChar(200)
  category String @db.VarChar(40)
  genres String[]
  experienceYears Int @map("experience_years")
  baseRateMinor Int @map("base_rate_minor")
  currency String @default("LKR") @db.Char(3)
  equipmentCategories String[] @map("equipment_categories")
  operatingHours Json @map("operating_hours")
  rentalTerms String @map("rental_terms") @db.VarChar(2000)
  deliveryOffered Boolean @default(false) @map("delivery_offered")
  reviewStatus String @default("draft") @map("review_status")
  reviewReason String? @map("review_reason") @db.VarChar(2000)
  approvedRevision Int? @map("approved_revision")
  approvedSnapshot Json? @map("approved_snapshot")
  approvedLatitude Decimal? @map("approved_latitude") @db.Decimal(5,2)
  approvedLongitude Decimal? @map("approved_longitude") @db.Decimal(5,2)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  user AuthUser @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@id([userId,kind])
  @@index([reviewStatus,updatedAt])
  @@map("provider_profiles")
}

model PendingEmailChange {
  userId String @id @map("user_id") @db.Uuid
  fromEmail String @map("from_email") @db.VarChar(200)
  newEmail String @map("new_email") @db.VarChar(200)
  tokenDigest String @unique @map("token_digest") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  user AuthUser @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@map("pending_email_changes")
}

model PayoutDestination {
  userId String @id @map("user_id") @db.Uuid
  revision Int @default(1)
  sealedDetails String @map("sealed_details")
  accountLast4 String @map("account_last4") @db.Char(4)
  status String @default("pending")
  reviewReason String? @map("review_reason") @db.VarChar(2000)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  user AuthUser @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([status,updatedAt])
  @@map("payout_destinations")
}

model ProfileAudit {
  id String @id @default(uuid()) @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  targetUserId String @map("target_user_id") @db.Uuid
  entity String @db.VarChar(40)
  action String @db.VarChar(40)
  revision Int
  reason String? @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([targetUserId,createdAt])
  @@map("profile_audits")
}

model PayoutDestinationVersion {
  userId String @map("user_id") @db.Uuid
  revision Int
  sealedDetails String @map("sealed_details")
  accountLast4 String @map("account_last4") @db.Char(4)
  status String @default("pending")
  reviewReason String? @map("review_reason") @db.VarChar(2000)
  reviewerId String? @map("reviewer_id") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user AuthUser @relation(fields:[userId], references:[id], onDelete:Cascade)
  payoutOrders PayoutOrder[]
  arbitrationDecisions ArbitrationDecision[]
  @@id([userId,revision])
  @@map("payout_destination_versions")
}

model Asset {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  purpose String @db.VarChar(20)
  filename String @db.VarChar(120)
  mime String @db.VarChar(80)
  bytes Int
  sha256 String @db.Char(64)
  status String @default("pending")
  variants Json @default("{}")
  metadata Json @default("{}")
  reason String? @db.VarChar(240)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz(3)
  leaseOwner String? @map("lease_owner") @db.Uuid
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(3)
  attempts Int @default(0)
  deleteAfter DateTime? @map("delete_after") @db.Timestamptz(3)
  owner AuthUser @relation(fields:[ownerId],references:[id],onDelete:Restrict)
  portfolio PortfolioItem[]
  avatars AvatarBinding[]
  holds AssetHold[]
  bookingAttachments BookingMessageAttachment[]
  reviewPhotos BookingReviewPhoto[]
  inspectionPhotos EquipmentInspectionPhoto[]
  verificationDocuments VerificationDocument[]
  supportAttachments SupportAttachment[]
  disputeAttachments BookingDisputeAttachment[]
  @@index([status,availableAt])
  @@index([ownerId,createdAt])
  @@map("assets")
}

model PortfolioItem {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  kind AuthRole
  assetId String? @map("asset_id") @db.Uuid
  embedUrl String? @map("embed_url") @db.VarChar(200)
  caption String @db.VarChar(240)
  transcript String @db.VarChar(4000)
  featured Boolean @default(false)
  revision Int @default(1)
  status String @default("draft")
  reason String? @db.VarChar(2000)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  owner AuthUser @relation(fields:[ownerId],references:[id],onDelete:Cascade)
  asset Asset? @relation(fields:[assetId],references:[id],onDelete:Restrict)
  rentalGallery RentalGalleryItem[]
  @@index([ownerId,kind])
  @@index([status,updatedAt])
  @@map("portfolio_items")
}

model AvatarBinding {
  ownerId String @id @map("owner_id") @db.Uuid
  assetId String @map("asset_id") @db.Uuid
  owner AuthUser @relation(fields:[ownerId],references:[id],onDelete:Cascade)
  asset Asset @relation(fields:[assetId],references:[id],onDelete:Restrict)
  @@map("avatar_bindings")
}

// Internal-only references. Future booking/KYC/support modules set holds in their own authorized transactions.
model AssetHold {
  id String @id @default(uuid()) @db.Uuid
  assetId String @map("asset_id") @db.Uuid
  reference String @unique @db.VarChar(120)
  until DateTime @db.Timestamptz(3)
  asset Asset @relation(fields:[assetId],references:[id],onDelete:Restrict)
  @@map("asset_holds")
}

enum GigStatus {
  draft
  published
  paused
  archived
}

model ArtistGig {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  revision Int @default(1)
  publishedVersion Int? @map("published_version")
  status GigStatus @default(draft)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  owner AuthUser @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  versions ArtistGigVersion[] @relation("GigVersions")
  publication ArtistGigVersion? @relation("GigPublication", fields: [id, publishedVersion], references: [gigId, version], onDelete: Restrict)
  @@index([ownerId, status])
  @@map("artist_gigs")
}

model ArtistGigVersion {
  gigId String @map("gig_id") @db.Uuid
  version Int
  title String @db.VarChar(120)
  description String @db.VarChar(2000)
  priceMinor Int @map("price_minor")
  packages Json @default("[]")
  gig ArtistGig @relation("GigVersions", fields: [gigId], references: [id], onDelete: Restrict)
  publications ArtistGig[] @relation("GigPublication")
  @@id([gigId, version])
  @@map("artist_gig_versions")
}

enum RentalStatus {
  draft
  published
  paused
  archived
}

enum RentalKind {
  equipment
  venue
  bundle
}

model RentalListing {
  kind RentalKind @default(equipment)
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  revision Int @default(1)
  publishedVersion Int? @map("published_version")
  status RentalStatus @default(draft)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  owner AuthUser @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  versions RentalListingVersion[] @relation("RentalVersions")
  publication RentalListingVersion? @relation("RentalPublication", fields: [id, publishedVersion], references: [listingId, version], onDelete: Restrict)
  inventory InventoryUnit[]
  gallery RentalGalleryItem[]
  @@unique([id, ownerId])
  @@index([ownerId, status])
  @@map("rental_listings")
}

model RentalListingVersion {
  listingId String @map("listing_id") @db.Uuid
  version Int
  title String @db.VarChar(120)
  description String @db.VarChar(2000)
  category String @db.VarChar(40)
  dailyRateMinor Int @map("daily_rate_minor")
  hourlyRateMinor Int? @map("hourly_rate_minor")
  weeklyRateMinor Int? @map("weekly_rate_minor")
  venueCapacity Int? @map("venue_capacity")
  bundleItems Json @default("[]") @map("bundle_items")
  depositPolicy Json @default("{\"mode\":\"none\",\"currency\":\"LKR\"}") @map("deposit_policy")
  stockQuantity Int @map("stock_quantity")
  specs Json @default("{}")
  listing RentalListing @relation("RentalVersions", fields: [listingId], references: [id], onDelete: Restrict)
  publications RentalListing[] @relation("RentalPublication")
  @@id([listingId, version])
  @@map("rental_listing_versions")
}

enum InventoryStatus {
  available
  out
  inspection
  maintenance
  quarantined
  retired
}

model InventoryUnit {
  id String @id @default(uuid()) @db.Uuid
  listingId String @map("listing_id") @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  serial String @db.VarChar(100)
  revision Int @default(1)
  status InventoryStatus @default(available)
  custodyReference String? @map("custody_reference") @db.VarChar(120)
  dueAt DateTime? @map("due_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  listing RentalListing @relation(fields: [listingId, ownerId], references: [id, ownerId], onDelete: Restrict)
  movements InventoryMovement[]
  inspectionUnits EquipmentInspectionUnit[]
  @@unique([ownerId, serial])
  @@index([ownerId, id])
  @@index([listingId, status])
  @@map("inventory_units")
}

model InventoryMovement {
  id BigInt @id @default(autoincrement())
  unitId String @map("unit_id") @db.Uuid
  revision Int
  fromStatus InventoryStatus? @map("from_status")
  toStatus InventoryStatus @map("to_status")
  reason String @db.VarChar(500)
  custodyReference String? @map("custody_reference") @db.VarChar(120)
  dueAt DateTime? @map("due_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  unit InventoryUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  @@unique([unitId, revision])
  @@map("inventory_movements")
}

model RentalGalleryItem {
  id String @id @default(uuid()) @db.Uuid
  listingId String @map("listing_id") @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  portfolioItemId String @map("portfolio_item_id") @db.Uuid
  revision Int @default(1)
  caption String @db.VarChar(240)
  position Int
  listing RentalListing @relation(fields: [listingId, ownerId], references: [id, ownerId], onDelete: Cascade)
  portfolioItem PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)
  @@unique([listingId, portfolioItemId])
  @@index([portfolioItemId])
  @@map("rental_gallery_items")
}

model PublicAnnouncement {
  id String @id @default(uuid()) @db.Uuid
  title String @db.VarChar(120)
  body String @db.VarChar(1000)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt DateTime? @map("ends_at") @db.Timestamptz(3)
  @@index([startsAt, id])
  @@map("public_announcements")
}

model EventBrief {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  title String @db.VarChar(120)
  description String @db.VarChar(2000)
  eventDate DateTime @map("event_date") @db.Date
  city String @db.VarChar(100)
  budgetMinor Int @map("budget_minor")
  requirements Json @default("[]")
  revision Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  owner AuthUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  recommendationRuns RecommendationRun[]
  @@index([ownerId, id])
  @@map("event_briefs")
}

enum SavedItemKind {
  artist
  gig
  rental
}

model SavedItem {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  kind SavedItemKind
  targetId String @map("target_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  owner AuthUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@unique([ownerId, kind, targetId])
  @@index([ownerId, id])
  @@map("saved_items")
}

model PrivateDraft {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  key String @db.VarChar(80)
  revision Int @default(1)
  payload Json
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  owner AuthUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@unique([ownerId, key])
  @@map("private_drafts")
}

model Inquiry {
  id String @id @default(uuid()) @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  providerId String @map("provider_id") @db.Uuid
  targetKind SavedItemKind @map("target_kind")
  targetId String @map("target_id") @db.Uuid
  targetVersion Int @map("target_version")
  title String @db.VarChar(120)
  requestKey String @map("request_key") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  customer AuthUser @relation("InquiryCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  provider AuthUser @relation("InquiryProvider", fields: [providerId], references: [id], onDelete: Restrict)
  messages InquiryMessage[]
  booking Booking?
  @@unique([customerId, requestKey])
  @@index([customerId, id])
  @@index([providerId, id])
  @@map("inquiries")
}

model InquiryMessage {
  id BigInt @id @default(autoincrement())
  inquiryId String @map("inquiry_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid
  requestKey String @map("request_key") @db.Uuid
  body String @db.VarChar(4000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  author AuthUser @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@unique([inquiryId, authorId, requestKey])
  @@index([inquiryId, id])
  @@map("inquiry_messages")
}

model AvailabilityCalendar {
  ownerId String @id @map("owner_id") @db.Uuid
  timezone String @db.VarChar(100)
  hours Json
  revision Int @default(1)
  owner AuthUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  blocks AvailabilityBlock[]
  @@map("availability_calendars")
}

model AvailabilityBlock {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt DateTime @map("ends_at") @db.Timestamptz(3)
  reason String @db.VarChar(500)
  calendar AvailabilityCalendar @relation(fields: [ownerId], references: [ownerId], onDelete: Cascade)
  @@index([ownerId, startsAt])
  @@map("availability_blocks")
}

enum ProviderDecision {
  accepted
